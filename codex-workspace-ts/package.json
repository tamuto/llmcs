{
  "name": "@infodb/codex-workspace",
  "version": "0.2.0",
  "description": "Run codex app-server in a container with only a workspace mounted (TypeScript)",
  "license": "MIT",
  "author": "tamuto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamuto/llmcs.git",
    "directory": "codex-workspace-ts"
  },
  "homepage": "https://github.com/tamuto/llmcs/tree/main/codex-workspace-ts#readme",
  "bugs": {
    "url": "https://github.com/tamuto/llmcs/issues"
  },
  "keywords": [
    "codex",
    "codex-app-server",
    "openai",
    "docker",
    "sandbox",
    "json-rpc"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docker"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3"
  }
}
